# TgVault — пример конфигурации.
# start.sh копирует этот файл в .env при первом запуске и генерирует TGV_SECRET_KEY.
# Существующий .env НИКОГДА не перезаписывается.

# --- App ---
# Адрес и порт FastAPI-бэкенда, уровень логирования и каталог с данными
# (логи, экспорты, ключ шифрования). TGV_SECRET_KEY — ключ Fernet для
# шифрования Telegram-сессий; если пусто, ключ будет создан в data/secret.key.
TGV_HOST=127.0.0.1
TGV_PORT=8077
TGV_LOG_LEVEL=INFO
TGV_DATA_DIR=./data
TGV_SECRET_KEY=

# --- MySQL ---
# Подключение к MySQL 8 (по умолчанию поднимается из docker/docker-compose.yml
# на нестандартном порту 13306, чтобы не конфликтовать с локальным сервером).
# TGV_DB_ECHO=true включает вывод SQL-запросов SQLAlchemy в лог.
TGV_MYSQL_HOST=127.0.0.1
TGV_MYSQL_PORT=13306
TGV_MYSQL_USER=tgvault
TGV_MYSQL_PASSWORD=tgvault
TGV_MYSQL_DB=tgvault
TGV_DB_ECHO=false

# --- Redis ---
# Шина событий (pub/sub) для прогресса экспорта и WebSocket.
# Если TGV_REDIS_ENABLED=false или Redis недоступен — используется in-memory fallback.
TGV_REDIS_URL=redis://127.0.0.1:16379/0
TGV_REDIS_ENABLED=true

# --- Telegram defaults (можно оставить пустым и вводить в UI) ---
# api_id / api_hash с https://my.telegram.org. Подставляются как значения
# по умолчанию в форме создания аккаунта; каждый аккаунт хранит свои в БД.
TGV_DEFAULT_API_ID=
TGV_DEFAULT_API_HASH=

# --- Export ---
# TGV_DOWNLOAD_CONCURRENCY — значение по умолчанию для ExportOptions.concurrency
# (1..16); в UI его можно переопределить для каждой задачи.
# TGV_FLOOD_SLEEP_THRESHOLD — порог FLOOD_WAIT в секундах: ниже него Telethon
# засыпает сам, выше — пауза делается явно и показывается в журнале задачи.
TGV_DOWNLOAD_CONCURRENCY=4
TGV_MAX_RETRIES=5
TGV_FLOOD_SLEEP_THRESHOLD=60

# --- Frontend ---
# Порт Vite dev-сервера (./start.sh --dev). В обычном режиме фронтенд
# собирается в frontend/dist и отдаётся самим бэкендом на TGV_PORT.
TGV_FRONTEND_PORT=5177

# --- Дополнительно (значения по умолчанию обычно менять не нужно) ---
# TGV_DATABASE_URL — полная замена DSN. Позволяет подключиться к внешнему MySQL
#   или запуститься без Docker на SQLite: sqlite+aiosqlite:///./data/tgvault.db
# TGV_DB_POOL_SIZE / TGV_DB_MAX_OVERFLOW — размер пула соединений SQLAlchemy.
# TGV_SERVE_FRONTEND=false — не отдавать frontend/dist (режим «только API»).
# TGV_REQUEST_RETRIES / TGV_CONNECTION_RETRIES — повторы на уровне Telethon.
# TGV_EXTRA_OPEN_ROOTS — дополнительные каталоги, которые разрешено открывать
#   через POST /api/system/open-folder (через ';' в Windows, ':' в Unix).
#   По умолчанию разрешён только TGV_DATA_DIR.
TGV_DATABASE_URL=
TGV_DB_POOL_SIZE=10
TGV_DB_MAX_OVERFLOW=20
TGV_SERVE_FRONTEND=true
TGV_REQUEST_RETRIES=5
TGV_CONNECTION_RETRIES=5
TGV_EXTRA_OPEN_ROOTS=
